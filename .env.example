DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=5432

REDIS_HOST=
REDIS_PORT=6379

# --- Redis (override opsional; default redis://{REDIS_HOST}:{REDIS_PORT}) ---
REDIS_URL=

# --- Database (override opsional; default diturunkan dari DB_* di atas) ---
