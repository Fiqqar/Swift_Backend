DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=db-test
DB_PORT=5432

REDIS_HOST=
REDIS_PORT=6379

# --- Redis (override opsional; default redis://{REDIS_HOST}:{REDIS_PORT}) ---
REDIS_URL=

# --- Database (override opsional; default diturunkan dari DB_* di atas) ---
DATABASE_URL=

# --- Pathfinding / OSM (opsional, default sesuai kode) ---
OSMNX_OVERPASS_URL=https://overpass-api.de/api
OSMNX_MAX_RADIUS=50000
OSMNX_CACHE_GRID=0.005
OSMNX_COVER_GRID=0.02
# Baca tile paralel (>=2 hanya membantu di filesystem lambat, mis. bind-mount
# Docker Desktop; host/VPS lebih cepat sekuensial karena parsing CPU-bound).
OSMNX_TILE_PARALLEL=1
OSMNX_DISK_CACHE=cache/pathfinding
OSMNX_ENABLE_CH=1
OSMNX_CH_WITNESS_NODES=2500
# Lewati Contraction Hierarchy bila graf lebih besar dari ini (build CH
# Python murni sangat lambat pada graf besar).
OSMNX_CH_MAX_NODES=80000
# Bulatkan radius cache ke atas (meter) supaya banyak request dgn panjang
# rute mirip memakai cache graf yang sama.
OSMNX_RADIUS_BUCKET=5000

# --- Local PBF (opsional; otomatis aktif bila ada file di PBF_DIR) ---
# Letakkan semua file regional per pulau di sini (mis. java-*.osm.pbf,
# sumatera-*.osm.pbf, sulawesi-*.osm.pbf, dst). Server akan mendeteksi
# bounding box tiap file dan memilih yang tepat per request.
USE_LOCAL_PBF=1
PBF_DIR=data/pbf
# --- Opsional, mode PBF tunggal (bila PBF_DIR tidak dipakai) ---
OSM_PBF_FILE_PATH=data/pbf/java-260805.osm.pbf

# --- Warm-up saat startup (lat1,lon1[,lat2,lon2] dipisah '|') ---
# 2 angka = satu titik, 4 angka = pasangan origin->dest.
# Pasangan pertama dimuat sinkron (untuk /health), sisanya di background.
# Default: pasangan Kudus, Jawa Tengah.
WARMUP_ANCHORS=-6.8048,110.8385,-6.8100,110.8500

# --- Validasi titik request ---
# Jarak maksimal (meter) antara koordinat request dan node jalan terdekat.
MAX_SNAP_DIST=1500

# --- Cache RAM ---
OSMNX_PG_CACHE_SIZE=16
OSMNX_GRAPH_CACHE_SIZE=32

# --- Graf regional (jalan utama) utk rute jarak kota menengah ---
# Dimuat saat startup dari cache disk; jalankan scripts/prebuild_region.py
# sekali utk pre-build cache agar rute >4 km tidak scan PBF besar di runtime.
# Format REGION_GRAPH_BBOX=lat1,lon1,lat2,lon2
# Default: Kudus-Semarang-Pati-Jepara (Jawa Tengah).
REGION_GRAPH_ENABLED=1
REGION_GRAPH_BBOX=-7.10,110.25,-6.40,111.20
# Filter jalan graf regional: 2 = semua jalan layak kendaraan minus jalan kecil
# (kualitas penuh), 3 = hanya tol/trunk/primary (ringan, antar-kota saja).
OSMNX_REGION_LEVEL=2
# Blokir cold-build dinamis (scan PBF besar) saat titik di luar cakupan graf
# yang sudah dimuat. 1 = izinkan (request pertama bisa sangat lambat);
# 0 = tolak cepat dgn pesan jelas + pre-warm manual via
# scripts/prewarm_route.py.
OSMNX_ALLOW_DYNAMIC_LOAD=0

# --- CORS (dipakai CORSMiddleware di app/main.py) ---
CORS_ORIGINS=http://localhost:8000

# --- Hierarchical routing (local tile + base jalan utama, Gmaps-style) ---
# Lapisan LOCAL: graf gang (level 1) di sekitar origin/tujuan, dibangun dari
# grid tile hasil scripts/split_tiles.py (sekali, offline). Dengan tile,
# build graf lokal untuk titik MANA PUN di Jawa hanya detik-menit, bukan
# scan PBF 895 MB (14-19 menit).
TILES_ENABLED=1
TILES_DIR=data/tiles
TILE_DEG=0.2
TILE_BUFFER_DEG=0.01
# Lapisan BASE: graf jalan utama seluruh Jawa (level 3), dibangun sekali via
# scripts/build_base_graph.py, dimuat LAZY ke RAM saat request jarak jauh
# pertama. Rute = local(origin) -> base -> local(dest).
BASE_GRAPH_ENABLED=1
BASE_GRAPH_LEVEL=3
# Radius graf lokal di sekitar titik (meter) & batas perbesaran saat mencari
# jalan utama terdekat.
LOCAL_RADIUS=3000
LOCAL_RADIUS_MAX=10000
# (Tidak lagi jadi gate utama) Semua rute > LOCAL_ROUTE_MAX_KM memakai
# hierarchical agar ujung origin/dest presisi hingga gang. Nilai ini hanya
# didokumentasikan untuk referensi.
HIERARCHICAL_MIN_KM=25
# Rute pendek (origin->dest <= ini, km) dirutekan lewat graf gang level-1 dari
# tile (presisi hingga gang). Di atasnya otomatis hierarchical (gang di kedua
# ujung + base jalan utama di tengah). 0 = nonaktif (pakai region).
LOCAL_ROUTE_MAX_KM=10
# Padding (meter) untuk graf covering rute pendek (>= MAX_SNAP_DIST agar
# snapping aman). Lebih kecil = lebih sedikit tile di-scan saat cold-build.
COVER_PAD_M=2500
# Bangun graf lokal origin & tujuan secara paralel saat hierarchical
# (memangkas waktu cold-build rute jauh).
HIER_PARALLEL_LOCAL=1
# Kota prioritas (lat,lon dipisah '|'): graf lokalnya dibangun di background
# saat startup agar rute dari/ke kota itu instan.
PREWARM_CITIES=-6.1751,106.8650|-6.9175,107.6191|-7.0051,110.4381|-7.7956,110.3695|-6.8048,110.8385|-6.9345,110.4167|-7.2504,111.4447|-7.9666,112.6326
# Prewarm sel covering (graf gang) di sekitar kota: OFFSET dalam derajat,
# CELLS = jumlah sel diagonal terdekat yang dibangun (0 = nonaktif).
PREWARM_COVER_OFFSET_DEG=0.03
PREWARM_COVER_CELLS=2