GH_TOKEN=
PBF_URL="https://github.com/mmm-chd/pathfinding_test/releases/download/v1.0.0-jawa/java-260805.osm.pbf"
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=db-test
DB_PORT=5432

REDIS_HOST=
REDIS_PORT=6379

# --- Redis (override opsional; default redis://{REDIS_HOST}:{REDIS_PORT}) ---
REDIS_URL=

# --- Database (override opsional; default diturunkan dari DB_* di atas) ---
DATABASE_URL=

# --- Pathfinding / OSM (opsional, default sesuai kode) ---
OSMNX_OVERPASS_URL=https://overpass-api.de/api
OSMNX_MAX_RADIUS=50000
OSMNX_CACHE_GRID=0.005
OSMNX_COVER_GRID=0.02
# Baca tile paralel (>=2 hanya membantu di filesystem lambat, mis. bind-mount
# Docker Desktop; host/VPS lebih cepat sekuensial karena parsing CPU-bound).
OSMNX_TILE_PARALLEL=1
OSMNX_DISK_CACHE=cache/pathfinding
OSMNX_ENABLE_CH=1
OSMNX_CH_WITNESS_NODES=2500
# Lewati Contraction Hierarchy bila graf lebih besar dari ini (build CH
# Python murni sangat lambat pada graf besar).
OSMNX_CH_MAX_NODES=80000
# Bulatkan radius cache ke atas (meter) supaya banyak request dgn panjang
# rute mirip memakai cache graf yang sama.
OSMNX_RADIUS_BUCKET=5000

# --- Local PBF (opsional; otomatis aktif bila ada file di PBF_DIR) ---
# Letakkan semua file regional per pulau di sini (mis. java-*.osm.pbf,
# sumatera-*.osm.pbf, sulawesi-*.osm.pbf, dst). Server akan mendeteksi
# bounding box tiap file dan memilih yang tepat per request.
USE_LOCAL_PBF=1
PBF_DIR=data/pbf
# --- Opsional, mode PBF tunggal (bila PBF_DIR tidak dipakai) ---
OSM_PBF_FILE_PATH=data/pbf/java-260805.osm.pbf

# --- Warm-up saat startup (lat1,lon1[,lat2,lon2] dipisah '|') ---
# 2 angka = satu titik, 4 angka = pasangan origin->dest.
# Pasangan pertama dimuat sinkron (untuk /health), sisanya di background.
# Default: pasangan Kudus, Jawa Tengah.
WARMUP_ANCHORS=-6.8048,110.8385,-6.8100,110.8500

# --- Validasi titik request ---
# Jarak maksimal (meter) antara koordinat request dan node jalan terdekat.
MAX_SNAP_DIST=1500

# --- Cache RAM ---
OSMNX_PG_CACHE_SIZE=16
OSMNX_GRAPH_CACHE_SIZE=32

# --- Graf regional (jalan utama) utk rute jarak kota menengah ---
# Dimuat saat startup dari cache disk; jalankan scripts/prebuild_region.py
# sekali utk pre-build cache agar rute >4 km tidak scan PBF besar di runtime.
# Format REGION_GRAPH_BBOX=lat1,lon1,lat2,lon2
# Default: Kudus-Semarang-Pati-Jepara (Jawa Tengah).
REGION_GRAPH_ENABLED=1
REGION_GRAPH_BBOX=-7.10,110.25,-6.40,111.20
# Filter jalan graf regional: 2 = semua jalan layak kendaraan minus jalan kecil
# (kualitas penuh), 3 = hanya tol/trunk/primary (ringan, antar-kota saja).
OSMNX_REGION_LEVEL=2
# Blokir cold-build dinamis (scan PBF besar) saat titik di luar cakupan graf
# yang sudah dimuat. 1 = izinkan (request pertama bisa sangat lambat);
# 0 = tolak cepat dgn pesan jelas + pre-warm manual via
# scripts/prewarm_route.py.
OSMNX_ALLOW_DYNAMIC_LOAD=1

# --- CORS (dipakai CORSMiddleware di app/main.py) ---
CORS_ORIGINS=http://localhost:8000

# --- Auth kurir (JWT) ---
# Secret wajib diganti di produksi. Token expire dalam menit (default 1440 = 24 jam).
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# --- Hierarchical routing (local tile + base jalan utama, Gmaps-style) ---
# Lapisan LOCAL: graf gang (level 1) di sekitar origin/tujuan, dibangun dari
# grid tile hasil scripts/split_tiles.py (sekali, offline). Dengan tile,
# build graf lokal untuk titik MANA PUN di Jawa hanya detik-menit, bukan
# scan PBF 895 MB (14-19 menit).
TILES_ENABLED=1
TILES_DIR=data/tiles
TILE_DEG=0.2
TILE_BUFFER_DEG=0.01
# Lapisan BASE: graf jalan utama seluruh Jawa (level 3), dibangun sekali via
# scripts/build_base_graph.py, dimuat LAZY ke RAM saat request jarak jauh
# pertama. Rute = local(origin) -> base -> local(dest).
BASE_GRAPH_ENABLED=1
BASE_GRAPH_LEVEL=3
# Radius graf lokal di sekitar titik (meter) & batas perbesaran saat mencari
# jalan utama terdekat.
LOCAL_RADIUS=3000
LOCAL_RADIUS_MAX=10000
# (Tidak lagi jadi gate utama) Semua rute > LOCAL_ROUTE_MAX_KM memakai
# hierarchical agar ujung origin/dest presisi hingga gang. Nilai ini hanya
# didokumentasikan untuk referensi.
HIERARCHICAL_MIN_KM=25
# Rute pendek (origin->dest <= ini, km) dirutekan lewat graf gang level-1 dari
# tile (presisi hingga gang). Di atasnya otomatis hierarchical (gang di kedua
# ujung + base jalan utama di tengah). 0 = nonaktif (pakai region).
LOCAL_ROUTE_MAX_KM=10
# Padding (meter) untuk graf covering rute pendek (>= MAX_SNAP_DIST agar
# snapping aman). Lebih kecil = lebih sedikit tile di-scan saat cold-build.
COVER_PAD_M=2500
# Bangun graf lokal origin & tujuan secara paralel saat hierarchical
# (memangkas waktu cold-build rute jauh).
HIER_PARALLEL_LOCAL=1
# Kota prioritas (lat,lon dipisah '|'): graf lokalnya dibangun di background
# saat startup agar rute dari/ke kota itu instan.
PREWARM_CITIES=-6.1751,106.8650|-6.9175,107.6191|-7.0051,110.4381|-7.7956,110.3695|-6.8048,110.8385|-6.9345,110.4167|-7.2504,111.4447|-7.9666,112.6326
# Prewarm sel covering (graf gang) di sekitar kota: OFFSET dalam derajat,
# CELLS = jumlah sel diagonal terdekat yang dibangun (0 = nonaktif).
PREWARM_COVER_OFFSET_DEG=0.03
PREWARM_COVER_CELLS=2

# --- Real-time traffic jam (integrasi arus lalu lintas) ---
# 1 = aktifkan poller background yang mengambil data traffic dari provider
#     dan menyimpan penalti bobot per edge ke Redis (traffic:penalties).
# 0 = (default) bobot standar tanpa pemrosesan traffic eksternal.
ENABLE_REALTIME_TRAFFIC=1
# Demo/testing offline: set 0 untuk menonaktifkan SEMUA probe TomTom (per-leg
# + corridor), respons /find-optimized-delivery-route jauh lebih cepat.
# Mode pengambilan traffic:
#   smart_hybrid  (default) = TomTom dipanggil on-demand per request hanya di
#                area Origin & Destination (cache grid ~500m, TTL
#                TRAFFIC_REDIS_TTL_SECONDS); jalur tengah memakai data
#                Internal dari poller global.
#   internal_only = hanya poller Internal (tanpa TomTom).
#   full_tomtom   = perilaku lama: poller global TomTom (probe statis) + Internal.
TRAFFIC_PROVIDER_MODE=smart_hybrid
# Batas waktu (detik) per panggilan HTTP TomTom (default 8.0). Turunkan ke
# ~2.5 bila TomTom lambat/unreachable agar leg tidak menunggu terlalu lama.
TOMTOM_TIMEOUT=2.5
# 1 = aktifkan evaluasi rerouting dinamis per leg (probe corridor TomTom).
# 0 = (default) tanpa corridor re-route; cukup probe O/D.
ENABLE_DYNAMIC_REROUTING=0
# Radius (km) dari Origin/Destination untuk memilih titik probe TomTom.
TOMTOM_PROBE_RADIUS_KM=5.0
# Bounded corridor sampling: jarak antar titik sampel TomTom di sepanjang
# corridor rute (km) & batas maksimum jumlah titik. Rute diprofil lalu bobot
# edge macet di-update di RAM dan re-route sekali bila ratio kemacetan
# melebihi TOMTOM_CONGESTION_RATIO.
TOMTOM_CORRIDOR_SAMPLE_KM=40
TOMTOM_CORRIDOR_MAX_SAMPLES=20
# Ambang kemacetan (ratio free-flow/current > nilai ini => re-route). Default 1.5.
TOMTOM_CONGESTION_RATIO=1.5
# TTL (detik) cache hasil TomTom per grid O/D di Redis (default 300 = 5 menit).
TRAFFIC_REDIS_TTL_SECONDS=300
# Interval pengambilan data (detik).
TRAFFIC_POLL_INTERVAL=20
# Sumber data internal: endpoint HTTP JSON, format:
#   {"incidents": [{"points": [[lat,lon],...], "multiplier": 2.5},
#                  {"points": [[lat,lon],...], "closure": true}]}
# Kosongkan bila tidak dipakai.
TRAFFIC_INTERNAL_URL=
# Toleransi proyeksi segmen traffic ke edge graf (meter).
TRAFFIC_SNAP_TOLERANCE_M=15

# --- Geocoding alamat (multi-stop delivery) ---
# Ubah alamat paket menjadi koordinat via Nominatim (OpenStreetMap) dengan
# cache Redis. TTL dalam detik (default 30 hari).
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_TTL=2592000
GEOCODE_TIMEOUT=8
# Jeda (detik) antar request Nominatim yang tidak ter-cache (rate-limit).
GEOCODE_RATE_DELAY=1.0

# --- Estimasi waktu tempuh (ETA) ---
# 1 = ETA custom: (jarak / kecepatan rata-rata moda) + SERVICE_TIME_MINUTES +
#     penalti belokan tajam, dan dipengaruhi traffic (penalty multiplier).
# 0 = (default) pure travel time = jarak / kecepatan standar jalan.
ENABLE_CUSTOM_ETA=0
# Overhead waktu layanan (menit) yang ditambahkan saat ENABLE_CUSTOM_ETA=1.
SERVICE_TIME_MINUTES=3
# Kecepatan rata-rata (km/jam) utk ETA custom. Default 40.
MODE_AVG_SPEED_KMH=40
# Kecepatan standar jalan (km/jam) utk pure travel time. Default 40.
DEFAULT_SPEED_KMH=40
# Sudut belokan (derajat) yang dianggap belokan tajam -> kena penalti waktu.
TURN_ANGLE_DEG=30
# Penalti waktu per belokan tajam (detik).
TURN_PENALTY_SECONDS=5

# --- TomTom Traffic Flow (opsional) ---
# API key dari TomTom Developer Portal.
TOMTOM_KEY=
# Titik probe (1 request per titik): "lat,lon|lat,lon|...". Semakin banyak
# titik, semakin luas cakupan namun semakin banyak request API per siklus.
TOMTOM_PROBE_POINTS=-6.8048,110.8385|-6.8100,110.8500
# Base URL (default api.tomtom.com) dan zoom segmen (default 10).
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_ZOOM=10
# Ambang kepercayaan data (0-1); segmen di bawahnya dibuang. Default 0.5.
TOMTOM_CONFIDENCE_MIN=0.5
# Batas maksimum request per siklus (0 = semua titik).
TOMTOM_MAX_REQUESTS=0
# Prioritas saat TomTom & Internal melaporkan edge yang sama: TOMTOM menang.

# --- Real-time tracking posisi kurir (WebSocket) ---
# Endpoint WS /api/v1/ws/driver/position (auth via token JWT dari
# POST /api/v1/auth/login, query ?token=... atau header Authorization Bearer).
# 1 = aktif; 0 = (default) koneksi WS ditolak kode 1008.
ENABLE_LIVE_TRACKING=0
# TTL posisi kurir di Redis (driver:pos:{kurir_id}), detik. Default 600 (10 menit).
KURIR_POS_TTL_SECONDS=600
# TTL state geofence per paket di Redis (driver:geofence:{kurir_id}:{package_id}),
# detik. Default 86400 (24 jam, mengikuti durasi sesi/batch aktif).
KURIR_GEOFENCE_TTL_SECONDS=86400
# TTL cache daftar stop belum terkirim per kurir (driver:stops:{kurir_id}), detik.
# Default 300 (5 menit).
KURIR_STOPS_TTL_SECONDS=300
# Rate limit pesan posisi per koneksi WS (detik antar update). Default 3.
KURIR_POS_MAX_RATE_SECONDS=3
# Cek status via GET /api/v1/ws/driver/position/status.

# --- Real-time navigation & auto-rerouting (WebSocket) ---
# Endpoint WS /api/v1/ws/navigation (auth via token JWT, query ?token=...
# atau header Authorization Bearer). Rute aktif di-snapshot ke Redis
# driver:nav:{kurir_id} oleh endpoint find-route / find-optimized-delivery-route.
# 1 = aktif; 0 = (default) koneksi WS ditolak kode 1008.
ENABLE_LIVE_NAVIGATION=1
# TTL snapshot rute aktif per kurir (driver:nav:{kurir_id}), detik. Default 3600.
KURIR_NAV_TTL_SECONDS=3600
# Ambang off-route: jarak kurir ke polyline rute (meter) yang memicu warning
# + reroute. Default 40.
OFF_ROUTE_THRESHOLD_M=40
# Cooldown auto-reroute (detik) untuk mencegah route flickering. Default 30.
REROUTE_COOLDOWN_SECONDS=30
# Interval evaluasi ulang traffic per sesi (detik). Default 30.
TRAFFIC_REROUTE_INTERVAL_SECONDS=30
# Hemat waktu minimal (detik) agar reroute traffic diterapkan. Default 120 (2 mnt).
TRAFFIC_REROUTE_MIN_SAVING_SECONDS=120
# 1 = server langsung menerapkan rute baru (kirim auto_rerouted);
# 0 = hanya kirim reroute_available (klien memutuskan). Default 1.
AUTO_REROUTE=1
# Ambang overlap maksimum antar rute alternatif (0..1) di find-route-options.
# Rute alternatif dengan overlap >= nilai ini akan didedupe. Default 0.7 (70%).
ALTERNATIVE_ROUTE_MAX_OVERLAP=0.7
# Rate limit pesan posisi per koneksi WS navigation (detik antar update). Default 3.
NAV_POS_MAX_RATE_SECONDS=3
# Interval minimum push route_progress (detik). Default 3.
NAV_PROGRESS_MIN_INTERVAL_SECONDS=3

# --- AI Agent (Gemini) untuk keputusan rerouting (opsional) ---
# 1 = keputusan reroute (traffic & off-route) diambil LLM Agent (Google Gemini)
#     dengan Function Calling; logika deterministik (threshold) menjadi fallback.
# 0 = (default) murni deterministik seperti sebelumnya.
AI_REROUTE_ENABLED=1
# API key dari Google AI Studio (https://aistudio.google.com/apikey).
# Wajib diisi bila AI_REROUTE_ENABLED=1.
GEMINI_API_KEY=
# API key cadangan (opsional): dipakai otomatis bila key 1 kena rate-limit
# (HTTP 429 / RESOURCE_EXHAUSTED). Tidak wajib.
GEMINI_API_KEY_2=
# Model Gemini yang dipakai. Default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Batas waktu (detik) satu keputusan LLM agar responsif di WebSocket real-time.
# Bila melampaui batas, server fallback ke logika deterministik. Default 2.0.
GEMINI_REROUTE_TIMEOUT_S=2.0
# Batas konkuransi panggilan LLM global (semaphore). Default 3.
GEMINI_MAX_CONCURRENT=3
# Jumlah kegagalan beruntun (error/timeout) yang memicu circuit breaker.
# Min 2. Default 3.
GEMINI_BREAKER_THRESHOLD=3
# Lama (detik) circuit breaker terbuka sebelum mencoba lagi. Default 30.
GEMINI_BREAKER_RESET_S=30
# Cek status via GET /api/v1/ws/navigation/status.

# --- RAG Berita Publik (Gemini Grounding + in-memory vector store, opsional) ---
# 1 = aktifkan pencarian berita gangguan lalu lintas (penutupan jalan, banjir,
#     perbaikan jalan, dll) sebagai penalti rute tambahan saat reroute.
# 0 = (default) nonaktif; routing murni tanpa penalti berita.
# Wajib GEMINI_API_KEY terisi bila RAG_NEWS_ENABLED=1.
RAG_NEWS_ENABLED=1
# Kota yang berita lalu lintasnya diingest secara periodik (mis. "Kudus").
# Worker di-skip bila kosong.
RAG_NEWS_CITY=
# Interval pengambilan/refresh berita (detik). Default 3600 (1 jam).
RAG_NEWS_INGEST_INTERVAL_S=3600
# Jumlah berita teratas hasil pencarian vektor yang dievaluasi per rute. Default 5.
RAG_NEWS_TOP_K=5
# TTL cache berita di Redis & cache penalti evaluasi (detik). Default 1800 (30 mnt).
RAG_NEWS_CACHE_TTL_S=1800
# Batas maksimum multiplier penalti berita per edge. Default 3.0.
RAG_NEWS_MAX_PENALTY=3.0
# Batas waktu (detik) satu panggilan embedding / evaluasi Gemini. Default 2.0.
RAG_NEWS_TIMEOUT_S=2.0
# Model embedding yang dipakai. Default text-embedding-004.
RAG_NEWS_EMBED_MODEL=text-embedding-004
# 1 = (default) deteksi kota dinamis dari koordinat polyline rute aktif via
#     reverse geocode Nominatim (NOMINATIM_URL, hormati GEOCODE_RATE_DELAY),
#     sehingga query Grounding otomatis mengikuti kota tempat kurir berada.
#     Bila gagal / nonaktif, fallback ke RAG_NEWS_CITY statis.
RAG_NEWS_DYNAMIC_CITY=1
# TTL (detik) cache hasil reverse geocode kota per grid di Redis. Default 3600.
RAG_NEWS_CITY_CACHE_TTL_S=3600

# --- Internal Report Agent (laporan kurir, opsional) ---
# 1 = aktifkan agent yang mengklasifikasi laporan kurir (POST /driver-reports),
#     mencocokkannya ke rute aktif kurir lain, dan melakukan reroute + push event
#     WS bila berdampak. 0 = (default) nonaktif; laporan tetap tersimpan pending.
# Wajib GEMINI_API_KEY terisi bila INTERNAL_REPORT_AGENT_ENABLED=1.
INTERNAL_REPORT_AGENT_ENABLED=1
# Interval pemindaian laporan pending (detik). Default 30.
INTERNAL_REPORT_INTERVAL_S=30
# Jarak maksimum insiden ke polyline rute kurir lain agar dianggap berdampak (m).
REPORT_IMPACT_RADIUS_M=500
# Severity minimum laporan yang diproses: LOW/MEDIUM/HIGH/BLOCKING. Default HIGH.
REPORT_SEVERITY_MIN=HIGH
# Jumlah laporan pending yang diproses per siklus. Default 20.
REPORT_BATCH=20
# Rate limit endpoint POST /driver-reports: maks laporan per kurir per jendela
# (detik) via Redis. Default 5 laporan / 300 detik.
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_S=300

# --- Cloudinary (upload foto POD server-side) ---
# Kredensial dari Cloudinary Dashboard (dibaca dari env, JANGAN commit nilai asli).
# Endpoint POST /api/v1/shipments/{id}/history/photo mengunggah foto
# ke Cloudinary lalu membuat riwayat POD (event pod_submitted).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder root di Cloudinary untuk file POD (default: pod).
CLOUDINARY_UPLOAD_FOLDER=pod