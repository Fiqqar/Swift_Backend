  "components": {
    "schemas": {
      "BatchAssignRequest": {
        "properties": {
          "paket_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Paket Ids",
            "description": "ID paket yang di-assign"
          },
          "kurir_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Kurir Id"
          },
          "hub_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hub Id"
          }
        },
        "type": "object",
        "required": ["paket_ids", "kurir_id"],
        "title": "BatchAssignRequest"
      },
      "BatchStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": ["picked_up", "delivered", "returned"],
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "BatchStatusUpdate"
      },
      "BillingUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": ["paid", "refunded"],
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "BillingUpdate"
      },
      "CodUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "const": "remitted",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "CodUpdate"
      },
      "Coordinate": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": ["latitude", "longitude"],
        "title": "Coordinate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryCreate": {
        "properties": {
          "event": {
            "type": "string",
            "enum": ["received_at_hub", "departed_hub"],
            "title": "Event"
          },
          "keterangan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keterangan"
          },
          "hub_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hub Id"
          }
        },
        "type": "object",
        "required": ["event"],
        "title": "HistoryCreate"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "default": ""
          },
          "password": {
            "type": "string",
            "title": "Password",
            "default": ""
          }
        },
        "type": "object",
        "title": "LoginRequest"
      },
      "MapSegment": {
        "properties": {
          "edge_id": {
            "type": "integer",
            "title": "Edge Id"
          },
          "multiplier": {
            "type": "number",
            "title": "Multiplier"
          },
          "closure": {
            "type": "boolean",
            "title": "Closure"
          },
          "coordinates": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": ["edge_id", "multiplier", "closure", "coordinates"],
        "title": "MapSegment"
      },
      "PenaltiesResponse": {
        "properties": {
          "penalties": {
            "items": {
              "$ref": "#/components/schemas/PenaltyEntry"
            },
            "type": "array",
            "title": "Penalties"
          }
        },
        "type": "object",
        "required": ["penalties"],
        "title": "PenaltiesResponse"
      },
      "PenaltyEntry": {
        "properties": {
          "edge_id": {
            "type": "integer",
            "title": "Edge Id"
          },
          "multiplier": {
            "type": "number",
            "title": "Multiplier"
          }
        },
        "type": "object",
        "required": ["edge_id", "multiplier"],
        "title": "PenaltyEntry"
      },
      "ProviderStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "active": {
            "type": "boolean",
