# --- Real-time traffic jam (integrasi arus lalu lintas) ---
# 1 = aktifkan poller background yang mengambil data traffic dari provider
#     dan menyimpan penalti bobot per edge ke Redis (traffic:penalties).
# 0 = (default) bobot standar tanpa pemrosesan traffic eksternal.
ENABLE_REALTIME_TRAFFIC=1
# Mode pengambilan traffic:
#   smart_hybrid  (default) = TomTom dipanggil on-demand per request hanya di
#                area Origin & Destination (cache grid ~500m, TTL
#                TRAFFIC_REDIS_TTL_SECONDS); jalur tengah memakai data
#                Internal dari poller global.
#   internal_only = hanya poller Internal (tanpa TomTom).
#   full_tomtom   = perilaku lama: poller global TomTom (probe statis) + Internal.
TRAFFIC_PROVIDER_MODE=smart_hybrid
TOMTOM_TIMEOUT=2.5
ENABLE_DYNAMIC_REROUTING=1
TOMTOM_PROBE_RADIUS_KM=5.0

TOMTOM_CORRIDOR_SAMPLE_KM=40
TOMTOM_CORRIDOR_MAX_SAMPLES=20

TRAFFIC_REDIS_TTL_SECONDS=300
TRAFFIC_POLL_INTERVAL=20

